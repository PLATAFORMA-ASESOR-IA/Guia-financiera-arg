---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página solicitada no existe o ha sido movida.">
  <div class="text-center py-20">
    <h1 class="text-6xl font-extrabold text-slate-300">404</h1>
    <h2 class="text-2xl font-bold text-slate-800 mt-4">Página no encontrada</h2>
    <p class="text-slate-600 mt-2">La sección que estás buscando no existe o la dirección cambió.</p>
    <div class="mt-8">
      <a href="/" class="px-6 py-3 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition">
        Volver a la Página Principal
      </a>
    </div>
  </div>
</Layout>
